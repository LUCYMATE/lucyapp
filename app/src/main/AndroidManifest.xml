<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Core Permissions ─────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- RECEIVE_BOOT_COMPLETED: lets BootReceiver restart services after device reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ── Agent / Agentic Action Permissions ───────────────────────────── -->
    <!-- QUERY_ALL_PACKAGES: Needed by AgentToolExecutor to search installed apps by name -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- BIND_VOICE_INTERACTION: Required for VoiceInteractionService (enforced by Android OS) -->
    <uses-permission android:name="android.permission.BIND_VOICE_INTERACTION" />
    <!-- BIND_ACCESSIBILITY_SERVICE: Required for SoltiniAccessibilityService -->
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Soltini">

        <!-- ── Main Entry Activity ──────────────────────────────────────── -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Soltini">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── AssistLaunchActivity ─────────────────────────────────────────
             Transparent trampoline that triggers the Gemini-style orb when
             the user long-presses Home or invokes the assistant role.
        ─────────────────────────────────────────────────────────────────── -->
        <activity
            android:name=".assistant.AssistLaunchActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- ── VoiceInteractionService ─────────────────────────────────────
             The core system hook that registers Soltini as a valid Android
             assistant. Must be granted ROLE_ASSISTANT via RoleManager.
             android:permission enforces only the OS can bind this service.
        ─────────────────────────────────────────────────────────────────── -->
        <service
            android:name=".assistant.SoltiniVoiceInteractionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/interaction_service" />
        </service>

        <!-- ── AccessibilityService ────────────────────────────────────────
             Gives Soltini the ability to call performGlobalAction(LOCK_SCREEN).
             Must be enabled manually in Settings → Accessibility.
             On Android 13+ sideloaded APKs: user must "Allow restricted settings" first.

             NOTE: We intentionally do NOT use android:process=":a11y" here.
             The entire agent automation stack (YouTubeAutomator, WhatsAppAutomator,
             AgentToolExecutor etc.) relies on SoltiniAccessibilityService.getInstance()
             which is a same-process singleton. A separate process would make
             getInstance() always return null in the main process.

             Android only auto-disables accessibility services on CRASH (uncaught exception).
             A SIGKILL from MIUI is NOT a crash — Android rebinds the service when
             the process restarts via AlarmManager + BootReceiver.
             All lifecycle callbacks are wrapped in try/catch to prevent crashes.
        ─────────────────────────────────────────────────────────────────── -->
        <service
            android:name=".agent.SoltiniAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>


        <!-- ── OverlayService ──────────────────────────────────────────── -->
        <service
            android:name=".overlay.OverlayService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                      android:value="floating_ai_avatar_overlay"/>
        </service>

        <!-- ── BackgroundVoiceService ──────────────────────────────────── -->
        <service
            android:name=".services.BackgroundVoiceService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="microphone|specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                      android:value="ai_voice_assistant_background"/>
        </service>

        <!-- ── BankingModeTileService (Quick Settings Tile) ─────────────── -->
        <service
            android:name=".services.BankingModeTileService"
            android:icon="@mipmap/ic_launcher"
            android:label="Soltini Banking Mode"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- ── BootReceiver ────────────────────────────────────────────────
             Starts Soltini services automatically after device reboot.
             Also fires on APK update (MY_PACKAGE_REPLACED) so the user
             never has to manually relaunch after an update.
        ─────────────────────────────────────────────────────────────────── -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
